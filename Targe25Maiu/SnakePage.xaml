<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Targe25Maiu.SnakePage"
    Title="Draakon jahib kristalle"
    BackgroundColor="#171329">

    <ScrollView
        Orientation="Both"
        HorizontalScrollBarVisibility="Default"
        VerticalScrollBarVisibility="Default">

        <VerticalStackLayout
            Padding="20"
            Spacing="16"
            WidthRequest="1080"
            HorizontalOptions="Center">

            <!-- PEALKIRI JA MENÜÜ -->

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="15">

                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="🐉 DRAAKON JAHIB KRISTALLE"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF" />

                    <Label
                        Text="Kogu kristalle, väldi kive ja täida ülesandeid!"
                        FontSize="14"
                        TextColor="#D8C4F0" />

                </VerticalStackLayout>

                <Button
                    x:Name="MenuButton"
                    Grid.Column="1"
                    Text="☰"
                    FontSize="22"
                    WidthRequest="55"
                    HeightRequest="50"
                    BackgroundColor="#392D50"
                    TextColor="White"
                    CornerRadius="14"
                    Clicked="MenuButton_Clicked" />

            </Grid>

            <!-- MAAILMADE JA RASKUSASTMETE VALIK -->

            <Border
                x:Name="SettingsPanel"
                IsVisible="False"
                BackgroundColor="#241C35"
                Stroke="#65547F"
                StrokeThickness="1"
                Padding="18">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="🌍 VALI MAAILM"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="12">

                        <Border
                            x:Name="ForestCard"
                            Grid.Column="0"
                            BackgroundColor="#225D42"
                            Stroke="#70E8A2"
                            StrokeThickness="2"
                            Padding="15">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="ForestCard_Tapped" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout
                                Spacing="6"
                                HorizontalOptions="Center">

                                <Label
                                    Text="🌲"
                                    FontSize="30"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Forest"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    x:Name="ForestSelected"
                                    Text="✓ VALITUD"
                                    FontSize="11"
                                    TextColor="#70E8A2"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            x:Name="NightCard"
                            Grid.Column="1"
                            BackgroundColor="#322744"
                            Stroke="#65547F"
                            StrokeThickness="1"
                            Padding="15">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="NightCard_Tapped" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout
                                Spacing="6"
                                HorizontalOptions="Center">

                                <Label
                                    Text="🌙"
                                    FontSize="30"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Night"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    x:Name="NightSelected"
                                    Text="✓ VALITUD"
                                    FontSize="11"
                                    TextColor="#9CA9FF"
                                    IsVisible="False"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            x:Name="CandyCard"
                            Grid.Column="2"
                            BackgroundColor="#322744"
                            Stroke="#65547F"
                            StrokeThickness="1"
                            Padding="15">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="CandyCard_Tapped" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout
                                Spacing="6"
                                HorizontalOptions="Center">

                                <Label
                                    Text="🍬"
                                    FontSize="30"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Candy"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    x:Name="CandySelected"
                                    Text="✓ VALITUD"
                                    FontSize="11"
                                    TextColor="#FFA1E5"
                                    IsVisible="False"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                    <Label
                        x:Name="WorldDescriptionLabel"
                        Text="🌲 Maagiline roheline mets."
                        FontSize="13"
                        TextColor="#D8C4F0" />

                    <BoxView
                        HeightRequest="1"
                        Color="#65547F" />

                    <Label
                        Text="🎮 VALI RASKUSASTE"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="12">

                        <Border
                            x:Name="EasyCard"
                            Grid.Column="0"
                            BackgroundColor="#322744"
                            Stroke="#65547F"
                            Padding="14">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="EasyCard_Tapped" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="🟢 EASY"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Aeglane · 0 kivi"
                                    FontSize="12"
                                    TextColor="#D8C4F0"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    x:Name="EasySelected"
                                    Text="✓ VALITUD"
                                    FontSize="11"
                                    TextColor="#4ADE80"
                                    IsVisible="False"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            x:Name="NormalCard"
                            Grid.Column="1"
                            BackgroundColor="#423457"
                            Stroke="#FACC15"
                            StrokeThickness="2"
                            Padding="14">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="NormalCard_Tapped" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="🟡 NORMAL"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Keskmine · 2 kivi"
                                    FontSize="12"
                                    TextColor="#D8C4F0"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    x:Name="NormalSelected"
                                    Text="✓ VALITUD"
                                    FontSize="11"
                                    TextColor="#FACC15"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            x:Name="HardCard"
                            Grid.Column="2"
                            BackgroundColor="#322744"
                            Stroke="#65547F"
                            Padding="14">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="HardCard_Tapped" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="🔴 HARD"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Kiire · 4 kivi"
                                    FontSize="12"
                                    TextColor="#D8C4F0"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    x:Name="HardSelected"
                                    Text="✓ VALITUD"
                                    FontSize="11"
                                    TextColor="#FB7185"
                                    IsVisible="False"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                    <Label
                        Text="Uue raskusastme kivid ilmuvad järgmise mängu alustamisel."
                        FontSize="12"
                        TextColor="#BDA9D5" />

                </VerticalStackLayout>

            </Border>

            <!-- PUNKTID -->

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="12">

                <Border
                    Grid.Column="0"
                    BackgroundColor="#29213F"
                    Padding="14">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="⭐ PUNKTID"
                            FontSize="12"
                            TextColor="#D8C4F0" />

                        <Label
                            x:Name="ScoreLabel"
                            Text="0"
                            FontSize="25"
                            FontAttributes="Bold"
                            TextColor="White" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Column="1"
                    BackgroundColor="#29213F"
                    Padding="14">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="🏆 REKORD"
                            FontSize="12"
                            TextColor="#D8C4F0" />

                        <Label
                            x:Name="BestLabel"
                            Text="0"
                            FontSize="25"
                            FontAttributes="Bold"
                            TextColor="#FFD166" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Column="2"
                    BackgroundColor="#29213F"
                    Padding="14">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="💎 KRISTALLID"
                            FontSize="12"
                            TextColor="#D8C4F0" />

                        <Label
                            x:Name="BerriesLabel"
                            Text="0"
                            FontSize="25"
                            FontAttributes="Bold"
                            TextColor="#70E5FF" />

                    </VerticalStackLayout>

                </Border>

            </Grid>

            <!-- MÄNG JA QUESTID -->

            <Grid
                ColumnDefinitions="370,*"
                ColumnSpacing="18">

                <!-- VASAK: MÄNGUVÄLJAK -->

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="12">

                    <Border
                        x:Name="BoardBorder"
                        BackgroundColor="#243F3B"
                        Stroke="#B28B4C"
                        StrokeThickness="3"
                        Padding="10">

                        <Grid
                            WidthRequest="330"
                            HeightRequest="330">

                            <GraphicsView
                                x:Name="GameCanvas"
                                WidthRequest="330"
                                HeightRequest="330"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                            <!-- +100 / +200 -->

                            <Label
                                x:Name="PointsPopup"
                                Text="+100"
                                FontSize="32"
                                FontAttributes="Bold"
                                TextColor="#70E5FF"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                InputTransparent="True"
                                IsVisible="False" />

                            <!-- GAME OVER -->

                            <Border
                                x:Name="GameOverOverlay"
                                IsVisible="False"
                                BackgroundColor="#E61B1429"
                                StrokeThickness="0"
                                Padding="15">

                                <VerticalStackLayout
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Spacing="12">

                                    <Label
                                        Text="🐉 GAME OVER"
                                        FontSize="25"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        x:Name="GameOverScoreLabel"
                                        Text="Punktid: 0"
                                        FontSize="16"
                                        TextColor="#FFD166"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Text="Vajuta Uus mäng!"
                                        FontSize="13"
                                        TextColor="White"
                                        HorizontalTextAlignment="Center" />

                                </VerticalStackLayout>

                            </Border>

                        </Grid>

                    </Border>

                    <Label
                        x:Name="StatusLabel"
                        Text="🐉 Mäng käib!"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <Border
                        BackgroundColor="#29213F"
                        Padding="14">

                        <VerticalStackLayout Spacing="9">

                            <Label
                                x:Name="BonusLabel"
                                Text="🌟 Järgmine boonus"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <ProgressBar
                                x:Name="BonusProgress"
                                Progress="0"
                                ProgressColor="#FFD166"
                                BackgroundColor="#514366" />

                            <Label
                                x:Name="BonusInfoLabel"
                                Text="Kogu 5 kristalli, et saada 2 boonuskristalli."
                                FontSize="12"
                                TextColor="#D8C4F0"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

                <!-- PAREM: QUESTID -->

                <Border
                    Grid.Column="1"
                    BackgroundColor="#241C35"
                    Stroke="#65547F"
                    StrokeThickness="1"
                    Padding="16"
                    HorizontalOptions="Fill">

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="📜 DRAAKONI QUESTID"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="White"
                                VerticalOptions="Center" />

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#423457"
                                Padding="10,6">

                                <Label
                                    x:Name="QuestCountLabel"
                                    Text="0 / 5"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#FFD166" />

                            </Border>

                        </Grid>

                        <Label
                            Text="Iga uue mänguga saad 5 juhuslikku ülesannet."
                            FontSize="12"
                            TextColor="#D8C4F0" />

                        <ScrollView
                            HeightRequest="440"
                            VerticalScrollBarVisibility="Default">

                            <VerticalStackLayout
                                x:Name="QuestListLayout"
                                Spacing="10"
                                HorizontalOptions="Fill" />

                        </ScrollView>

                    </VerticalStackLayout>

                </Border>

            </Grid>

            <!-- JUHTNUPUD -->

            <Border
                BackgroundColor="#241C35"
                Stroke="#65547F"
                Padding="18">

                <VerticalStackLayout
                    Spacing="14"
                    HorizontalOptions="Center">

                    <Label
                        Text="🎮 JUHI DRAAKONIT"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <Button
                        x:Name="UpButton"
                        Text="▲"
                        WidthRequest="75"
                        HeightRequest="55"
                        FontSize="25"
                        BackgroundColor="#49375E"
                        TextColor="White"
                        CornerRadius="14"
                        Clicked="UpButton_Clicked"
                        HorizontalOptions="Center" />

                    <HorizontalStackLayout
                        Spacing="12"
                        HorizontalOptions="Center">

                        <Button
                            x:Name="LeftButton"
                            Text="◀"
                            WidthRequest="75"
                            HeightRequest="55"
                            FontSize="25"
                            BackgroundColor="#49375E"
                            TextColor="White"
                            CornerRadius="14"
                            Clicked="LeftButton_Clicked" />

                        <Button
                            x:Name="DownButton"
                            Text="▼"
                            WidthRequest="75"
                            HeightRequest="55"
                            FontSize="25"
                            BackgroundColor="#49375E"
                            TextColor="White"
                            CornerRadius="14"
                            Clicked="DownButton_Clicked" />

                        <Button
                            x:Name="RightButton"
                            Text="▶"
                            WidthRequest="75"
                            HeightRequest="55"
                            FontSize="25"
                            BackgroundColor="#49375E"
                            TextColor="White"
                            CornerRadius="14"
                            Clicked="RightButton_Clicked" />

                    </HorizontalStackLayout>

                    <HorizontalStackLayout
                        Spacing="12"
                        HorizontalOptions="Center">

                        <Button
                            x:Name="NewGameButton"
                            Text="🔄 Uus mäng"
                            WidthRequest="160"
                            HeightRequest="55"
                            BackgroundColor="#267D58"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            Clicked="NewGameButton_Clicked" />

                        <Button
                            x:Name="PauseButton"
                            Text="⏸ Paus"
                            WidthRequest="160"
                            HeightRequest="55"
                            BackgroundColor="#7554A4"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            Clicked="PauseButton_Clicked" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

            <Label
                Text="💎 Tavaline kristall +100   🌟 Boonuskristall +200   🪨 Väldi kive!"
                FontSize="13"
                TextColor="#D8C4F0"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
