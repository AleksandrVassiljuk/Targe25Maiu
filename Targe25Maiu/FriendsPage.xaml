<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Targe25Maiu.FriendsPage"
             Title="Kontaktid"
             BackgroundColor="#F2F6FA">

    <Grid Padding="15"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
          RowSpacing="8">

        <!-- PEALKIRI -->
        <Label Grid.Row="0"
               Text="Sõprade kontaktid"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- PILT -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="5"
                             HorizontalOptions="Center">

            <Image x:Name="FriendImage"
                   Source="dotnet_bot.png"
                   WidthRequest="100"
                   HeightRequest="100"
                   Aspect="AspectFit" />

            <HorizontalStackLayout Spacing="10">

                <!-- Teeb kaameraga foto -->
                <Button Text="TEE FOTO"
                        Clicked="TakePhoto_Clicked" />

                <!-- Valib galeriist foto -->
                <Button Text="VALI GALERIIST"
                        Clicked="ChoosePhoto_Clicked" />

            </HorizontalStackLayout>

            <Label x:Name="PiltLabel"
                   Text="Pilti pole valitud"
                   FontSize="12"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>

        <!-- NIMI -->
        <Entry Grid.Row="2"
               x:Name="NameEntry"
               Placeholder="Nimi" />

        <!-- EMAIL -->
        <Entry Grid.Row="3"
               x:Name="EmailEntry"
               Placeholder="Email"
               Keyboard="Email" />

        <!-- TELEFON -->
        <Entry Grid.Row="4"
               x:Name="PhoneEntry"
               Placeholder="Telefon"
               Keyboard="Telephone" />

        <!-- KIRJELDUS -->
        <Entry Grid.Row="5"
               x:Name="DescriptionEntry"
               Placeholder="Kirjeldus" />

        <!-- LISA / MUUDA / KUSTUTA -->
        <HorizontalStackLayout Grid.Row="6"
                               Spacing="10"
                               HorizontalOptions="Center">

            <Button Text="LISA"
                    Clicked="AddFriend_Clicked" />

            <Button Text="MUUDA"
                    Clicked="EditFriend_Clicked" />

            <Button Text="KUSTUTA"
                    Clicked="DeleteFriend_Clicked" />

        </HorizontalStackLayout>

        <!-- SÕNUM -->
        <Entry Grid.Row="7"
               x:Name="MessageEntry"
               Placeholder="Kirjuta sõnum..." />

        <!-- KONTAKTI NUPUD -->
        <HorizontalStackLayout Grid.Row="8"
                               Spacing="6"
                               HorizontalOptions="Center">

            <Button Text="HELISTA"
                    FontSize="12"
                    Clicked="Call_Clicked" />

            <Button Text="SMS"
                    FontSize="12"
                    Clicked="SendSms_Clicked" />

            <Button Text="EMAIL"
                    FontSize="12"
                    Clicked="SendEmail_Clicked" />

            <Button Text="ÕNNITLUSED"
                    FontSize="12"
                    Clicked="Greeting_Clicked" />

        </HorizontalStackLayout>

        <!-- KONTAKTIDE NIMEKIRI -->
        <ListView Grid.Row="9"
                  x:Name="FriendsList"
                  HasUnevenRows="True"
                  SelectionMode="Single"
                  ItemTapped="Friend_ItemTapped">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <ViewCell>

                        <Grid Padding="10"
                              ColumnDefinitions="110,*"
                              MinimumHeightRequest="120">

                            <!-- KONTAKTI PILT -->
                            <Image Grid.Column="0"
                                   Source="{Binding Pilt}"
                                   WidthRequest="90"
                                   HeightRequest="100"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                            <!-- KONTAKTI ANDMED -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Margin="15,0,0,0"
                                                 Spacing="4"
                                                 VerticalOptions="Center">

                                <Label Text="{Binding Nimi}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="Black" />

                                <Label Text="{Binding Telefon}"
                                       FontSize="15"
                                       TextColor="Black" />

                                <Label Text="{Binding Email}"
                                       FontSize="14"
                                       TextColor="Black" />

                                <Label Text="{Binding Kirjeldus}"
                                       FontSize="13"
                                       TextColor="Gray" />

                            </VerticalStackLayout>

                        </Grid>

                    </ViewCell>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</ContentPage>