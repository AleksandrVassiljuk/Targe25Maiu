<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Targe25Maiu.CarouselPage"
             Title="Programmeerimiskeeled">

    <!-- Lehe gradient taust -->
    <ContentPage.Background>

        <LinearGradientBrush StartPoint="0,0"
                             EndPoint="1,1">

            <GradientStop Color="#E3F2FD"
                          Offset="0.0" />

            <GradientStop Color="#BBDEFB"
                          Offset="0.5" />

            <GradientStop Color="#90CAF9"
                          Offset="1.0" />

        </LinearGradientBrush>

    </ContentPage.Background>


    <Grid Padding="25"
          RowDefinitions="Auto,Auto,*,Auto,Auto"
          RowSpacing="18">


        <!-- Lehe pealkiri -->
        <Label x:Name="TitleLabel"
               Grid.Row="0"
               Text="Programmeerimiskeeled"
               FontSize="30"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="#1A237E" />


        <!-- Keele valimine -->
        <HorizontalStackLayout Grid.Row="1"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Spacing="12">


            <!-- Valitud keele riigi lipp -->
            <Image x:Name="CountryFlag"
                   Source="estonia.png"
                   WidthRequest="45"
                   HeightRequest="30"
                   Aspect="AspectFit"
                   VerticalOptions="Center" />


            <!-- Keele tekst -->
            <Label x:Name="LanguageLabel"
                   Text="Keel:"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="#263238" />


            <!-- Keele valik -->
            <Picker x:Name="LanguagePicker"
                    WidthRequest="160"
                    VerticalOptions="Center"
                    SelectedIndexChanged="LanguagePicker_SelectedIndexChanged">

                <Picker.Items>

                    <x:String>Eesti</x:String>

                    <x:String>English</x:String>

                </Picker.Items>

            </Picker>

        </HorizontalStackLayout>


        <!-- Programmeerimiskeele kaart -->
        <Border x:Name="LanguageCard"
                Grid.Row="2"
                Margin="20"
                Padding="30"
                BackgroundColor="White"
                Stroke="#3F51B5"
                StrokeThickness="2">


            <!-- Ümarad nurgad -->
            <Border.StrokeShape>

                <RoundRectangle CornerRadius="30" />

            </Border.StrokeShape>


            <!-- Kaardi vari -->
            <Border.Shadow>

                <Shadow Brush="#808080"
                        Offset="5,5"
                        Radius="12"
                        Opacity="0.4" />

            </Border.Shadow>


            <!-- Kaardile vajutamine -->
            <Border.GestureRecognizers>

                <TapGestureRecognizer
                    Tapped="Card_Tapped" />

            </Border.GestureRecognizers>


            <!-- Kaardi sisu -->
            <VerticalStackLayout Spacing="16"
                                 VerticalOptions="Center">


                <!-- Programmeerimiskeele logo -->
                <Image x:Name="LanguageImage"
                       HeightRequest="150"
                       WidthRequest="150"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />


                <!-- Programmeerimiskeele nimi -->
                <Label x:Name="NameLabel"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="#1A237E" />


                <!-- Programmeerimiskeele kirjeldus -->
                <Label x:Name="DescriptionLabel"
                       FontSize="18"
                       HorizontalTextAlignment="Center"
                       TextColor="#424242" />


                <!-- Lisainfo tekst -->
                <Label x:Name="InfoLabel"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="Gray" />


                <!-- Veebilehe nupp -->
                <Button x:Name="WebsiteButton"
                        Text="Ava veebileht"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Padding="25,10"
                        HorizontalOptions="Center"
                        BackgroundColor="#5C6BC0"
                        TextColor="White"
                        CornerRadius="15"
                        Clicked="WebsiteButton_Clicked">

                    <Button.Shadow>

                        <Shadow Brush="#808080"
                                Offset="2,3"
                                Radius="6"
                                Opacity="0.3" />

                    </Button.Shadow>

                </Button>


            </VerticalStackLayout>

        </Border>


        <!-- Näitab mitmes kaart on -->
        <Label x:Name="PositionLabel"
               Grid.Row="3"
               Text="1 / 5"
               FontSize="17"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#1A237E" />


        <!-- Tagasi ja Järgmine -->
        <Grid Grid.Row="4"
              ColumnDefinitions="*,*"
              ColumnSpacing="20">


            <!-- Tagasi -->
            <Button x:Name="PreviousButton"
                    Grid.Column="0"
                    Text="Tagasi"
                    FontSize="18"
                    FontAttributes="Bold"
                    HeightRequest="58"
                    BackgroundColor="#3949AB"
                    TextColor="White"
                    CornerRadius="20"
                    Clicked="PreviousButton_Clicked">

                <Button.Shadow>

                    <Shadow Brush="#808080"
                            Offset="3,4"
                            Radius="8"
                            Opacity="0.4" />

                </Button.Shadow>

            </Button>


            <!-- Järgmine -->
            <Button x:Name="NextButton"
                    Grid.Column="1"
                    Text="Järgmine"
                    FontSize="18"
                    FontAttributes="Bold"
                    HeightRequest="58"
                    BackgroundColor="#3949AB"
                    TextColor="White"
                    CornerRadius="20"
                    Clicked="NextButton_Clicked">

                <Button.Shadow>

                    <Shadow Brush="#808080"
                            Offset="3,4"
                            Radius="8"
                            Opacity="0.4" />

                </Button.Shadow>

            </Button>


        </Grid>

    </Grid>

</ContentPage>